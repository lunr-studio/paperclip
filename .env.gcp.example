# Copy this file to .env.gcp before deploying and tighten its permissions with:
# chmod 600 .env.gcp

PAPERCLIP_PUBLIC_URL=https://paperclip.34-123-45-67.sslip.io
PAPERCLIP_HOSTNAME=paperclip.34-123-45-67.sslip.io
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
PAPERCLIP_AGENT_JWT_SECRET=replace-with-openssl-rand-hex-32
ANTHROPIC_API_KEY=

# Persistent host paths for the single-VM deployment.
PAPERCLIP_DATA_DIR=/opt/paperclip/data
PAPERCLIP_CADDY_DATA_DIR=/opt/paperclip/caddy-data
PAPERCLIP_CADDY_CONFIG_DIR=/opt/paperclip/caddy-config

# Match the Linux user/group that should own the mounted Paperclip volume.
USER_UID=1000
USER_GID=1000

# Leave OPENAI_API_KEY unset when codex_local should use native Codex login.
